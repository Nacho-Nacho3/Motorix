{
  "name": "motorix-server",
  "version": "1.0.0",
  "description": "API del Sistema de Gestión para Taller Mecánico Motorix",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/tests/helpers/setup-env.js"
    ]
