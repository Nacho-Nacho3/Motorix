# Base de datos MySQL local (usuario dedicado al proyecto, NUNCA root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=motorix_app
DB_PASSWORD=cambiar_en_local
DB_NAME=motorix

# Base de datos de pruebas (la usan Jest + supertest; nunca la principal)
DB_TEST_NAME=motorix_test

# Seguridad
JWT_SECRET=cambiar_en_local_min_32_caracteres

# Mercado Pago (sandbox, opcional) — Sprint 4, CA-7: NUNCA valores reales en
# el repositorio; solo se versiona este archivo con placeholders. Sin llenar,
# el método Mercado Pago responde 409 «no disponible» y el resto opera igual.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
